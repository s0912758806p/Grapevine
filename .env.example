# Copy to .env.local for local development. Never prefix secrets with NEXT_PUBLIC_.
# Setup steps for every value: DEPLOY.md → 接上 GitHub Discussions 與登入.

# Public site URL: canonical links, Open Graph, sitemap and the sign-in callback URL.
SITE_URL=http://localhost:3000

# --- Forum data (GitHub Discussions) ----------------------------------------
# Without these two the forum shows built-in sample data with a banner.
GITHUB_FORUM_REPO=
GITHUB_READ_TOKEN=

# --- Member sign-in (GitHub App) --------------------------------------------
# Without these, the forum is read-only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32+ random characters, e.g. `openssl rand -base64 48`; changing it signs everyone out.
SESSION_SECRET=
