# Copy to .env.local for local development. Never prefix secrets with NEXT_PUBLIC_.

# Public site URL, used for canonical links, Open Graph and the sitemap.
SITE_URL=http://localhost:3000

# --- GitHub Discussions (next PR) -------------------------------------------
# Without these the forum runs on built-in sample data and shows a banner.
# GITHUB_FORUM_REPO=owner/repo          # repo whose Discussions back the forum
# GITHUB_READ_TOKEN=                    # server-side token for reads (fine-grained, read-only)
# GITHUB_CLIENT_ID=                     # GitHub OAuth App, for member sign-in and writes
# GITHUB_CLIENT_SECRET=
# GITHUB_BOT_TOKEN=                     # posts anonymous rumors on the member's behalf
# SESSION_SECRET=                       # 32+ random bytes, encrypts the session cookie
